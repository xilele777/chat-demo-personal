{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-chat",
  "account_id": "4386b7f5f88b93bd4baea4481882bd83",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-chat",
      "database_id": "39ca1926-e07f-434e-917a-f9665515acb9",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "personal-chat-files" }],
  "vars": {
    "UPSTREAM_PROTOCOL": "openai",
    "OPENAI_API_STYLE": "responses",
    "UPSTREAM_BASE_URL": "https://ai.apizn.com/v1",
    "UPSTREAM_MODEL": "gpt-6.2-sol",
    "MAX_OUTPUT_TOKENS": "32768",
    "MAX_INPUT_TOKENS": "196608",
  },
  "observability": { "enabled": false },
}
