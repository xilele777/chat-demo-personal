{
  "name": "chat-demo",
  "version": "0.1.3",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build.mjs",
    "build:cloud": "node scripts/build.mjs --cloud",
    "dev:cloud": "pnpm build:cloud && wrangler dev --ip 127.0.0.1",
    "deploy:cloud": "pnpm build:cloud && pnpm db:remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply personal-chat --local",
    "db:remote": "wrangler d1 migrations apply personal-chat --remote",
    "type:worker": "tsc -p tsconfig.worker.json",
    "test:context": "node --import tsx scripts/check-context.mjs",
    "test:mcp-context": "node --import tsx scripts/check-mcp-context.mjs",
    "test:streaming-ui": "node scripts/check-streaming-ui.mjs",
    "test:product": "node --import tsx scripts/check-product.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:interactions": "node scripts/check-interactions.mjs",
    "test:anthropic": "node --import tsx scripts/check-anthropic.mjs",
    "test:cloud": "node --import tsx scripts/smoke-cloud.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src worker rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "jose": "^6.2.18",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "wrangler": "^4.166.0"
  }
}
